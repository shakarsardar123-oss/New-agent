  // ─── Phase Labels (کوردی) ────────────────────────────────────────

  @override
  String get recoveryPhaseIdle => 'بێکار';
  @override
  String get recoveryPhaseDetecting => 'دۆزینەوەی هەڵە…';
  @override
  String get recoveryPhaseClassifying => 'پۆلێنکردنی جۆری هەڵە…';
  @override
  String get recoveryPhaseAnalyzing => 'شیکردنەوەی هەڵە…';
  @override
  String get recoveryPhaseStrategizing => 'دیاریکردنی ستراتیژی گەڕانەوە…';
