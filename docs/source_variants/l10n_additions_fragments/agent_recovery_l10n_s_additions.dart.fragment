  @override
  String get recoveryFailureTimeout => 'کات تەواو بوو';
  @override
  String get recoveryFailureCancellation => 'هەڵوەشایەوە';
  @override
  String get recoveryFailureInvalidParameters =>
      'پارامێتەرەکان نادروستن';
  @override
  String get recoveryFailureTargetNotFound =>
      'ئامانج نەدۆزرایەوە';
