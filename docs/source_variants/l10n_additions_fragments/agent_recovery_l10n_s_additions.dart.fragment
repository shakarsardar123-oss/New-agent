  @override
  String get recoveryPhaseVerifying => 'پشتڕاستکردنەوەی ئەنجام…';
  @override
  String get recoveryPhaseCompleted => 'گەڕانەوە تەواو بوو';
  @override
  String get recoveryPhaseFailed => 'گەڕانەوە سەرکەوتوو نەبوو';
  @override
  String get recoveryPhaseCancelled => 'گەڕانەوە هەڵوەشایەوە';

